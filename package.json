{
  "name": "{{package_name}}",
  "version": "{{project_version}}",
  "description": "{{project_description}}",
  "private": true,
  "type": "module",
  "license": "{{license_spdx_id}}",
  "author": "{{maintainer_name}} <{{maintainer_contact}}>",
  "repository": {
    "type": "git",
    "url": "https://{{repository_url}}"
  },
  "bugs": {
    "url": "https://{{issue_tracker_url}}"
  },
  "homepage": "https://{{homepage_url}}",
  "keywords": [
    "{{project_keyword}}"
  ],
  "engines": {
    "{{runtime}}": "{{runtime_version}}"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "bun run format:check"
  },
  "devDependencies": {
    "prettier": "^3.8.3"
  }
}
